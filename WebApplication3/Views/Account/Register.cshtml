@model WebApplication3.Models.RegisterViewModel2
<body style="background-image: url('/images/indexbg.jpg');">
    <div class="login-box">
    <h2>Register</h2>
        <form method="post" asp-action="Register">
            <div class="user-box">
                <input asp-for="FirstName" required />
                <label asp-for="FirstName">First Name</label>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="user-box">
                <input asp-for="LastName" required />
                <label asp-for="LastName">Last Name</label>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="user-box">
                <input asp-for="Username" required />
                <label asp-for="Username">Username</label>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="user-box">
                <input asp-for="Password" type="password" required />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="user-box">
                <input asp-for="ConfirmPassword" type="password" required />
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <center>
                <button type="submit" value="Submit" class="a">Register</button>
            </center>
        </form>
        <center>
            <button class="a" onclick="location.href='@Url.Action("Login", "Account")'" type="button">
                Return to login page
            </button>
        </center>
    </div>
</body>
