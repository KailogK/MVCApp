@model WebApplication3.Models.CreateSellerViewModel

@{
    ViewBag.Title = "Promote User to Seller";
}

<body>
<style>
        body {
            background-image: url('/images/indexbg.jpg');
            background-size: cover;
            background-position: center;
            background-color: #1e1e1e;
            color: white;
            font-family: Arial, sans-serif;
        }

    .login-box {
        width: 600px;
        margin: 0 auto;
    }

    .description {
        display: none;
        color: white;
        background-color: rgba(0, 0, 0, 0.5);
        padding: 10px;
        border-radius: 5px;
    }

    .transparent-input {
        background-color: transparent;
        border: 1px solid white;
        color: white;
        padding: 5px;
        font-size: 14px;
        width: 200px;
        margin-right: 10px;
    }

    .review-button {
        display: inline-block;
        text-align: center;
        color: #03e9f4;
        font-size: 12px;
        text-decoration: none;
        text-transform: uppercase;
        overflow: hidden;
        transition: 0.25s;
        letter-spacing: 2px;
        background-color: transparent;
        border: none;
    }

        button {
            display: inline-block;
            padding: 10px 20px;
            font-size: 14px;
            color: white;
            background-color: transparent;
            border: 2px solid #03e9f4;
            border-radius: 5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
        }

            button:hover {
                background-color: #03e9f4;
                color: #1e1e1e;
                box-shadow: 0 0 10px #03e9f4, 0 0 20px #03e9f4, 0 0 30px #03e9f4;
            }

        .review-button:hover {
            background: #03e9f4;
            color: #fff;
            border-radius: 5px;
            box-shadow: 0 0 5px #03e9f4, 0 0 25px #03e9f4, 0 0 50px #03e9f4, 0 0 100px #03e9f4;
        }

        select.transparent-input {
            background-color: transparent; /* Makes the select transparent */
            border: 1px solid white;
            color: white;
            padding: 5px;
            font-size: 14px;
            appearance: none; /* Removes default browser styling (like dropdown arrow) */
            -webkit-appearance: none; /* For Safari */
            -moz-appearance: none; /* For Firefox */
        }

            select.transparent-input option {
                background-color: rgba(0, 0, 0, 0.8); /* Semi-transparent background for options */
                color: white; /* Text color */
            }

                select.transparent-input option:hover {
                    background-color: rgba(255, 255, 255, 0.2); /* Hover effect for options */
                    color: #03e9f4;
                }

        .alert-success {
            color: #fff;
            background-color: #28a745;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
            margin-bottom: 20px;
        }

</style>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success" id="successMessage">
        @TempData["Message"]
    </div>
}
<div class="login-box">
    <h2>Promote User to Seller</h2>


    <form asp-action="CreateSeller" method="post" class="add-book-form">
        <div class="form-group">
            <center>
            @if (Model.UsersList != null && Model.UsersList.Any())
            {
                <select asp-for="UserId" asp-items="Model.UsersList" class="transparent-input">
                    <option value="">-- Select User --</option>
                </select>
            }
            else
            {
                <p style="color: white;">No users available to promote.</p>
            }
            </center>
        </div>
        <hr /><hr /><center><button type="submit" class="review-button">Promote to Seller</button></center>
    </form>

    <hr /><hr /><center><button onclick="location.href='@Url.Action("Home", "Admins")'" type="button">Return to Menu</button></center>
</div>
</body>

@section Scripts {
    <script>
        // Check if the success message exists
        window.onload = function () {
            var messageElement = document.getElementById("successMessage");

            if (messageElement) {
                setTimeout(function () {
                    messageElement.style.display = "none"; // Hide the success message after 3 seconds
                }, 3000); // 3000 milliseconds = 3 seconds
            }
        }
    </script>
}
